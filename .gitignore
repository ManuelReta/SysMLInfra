# =============================================================================
# .gitignore — SysML v2 infrastructure repository
# =============================================================================

# Separate standalone application — not part of SysMLInfra.
# Stays on the developer's local disk; never pushed to this repository.
STPA_Tool/

# Runtime state written by verify.py / commit.sh — re-generated on every run.
# lib/.gitkeep is committed so the directory exists on a fresh clone.
lib/*
!lib/.gitkeep

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoint directories (auto-created by Jupyter when saving)
.ipynb_checkpoints/

# OS / editor noise
.DS_Store
*.swp
*.swo
./venv/
.env
deps/